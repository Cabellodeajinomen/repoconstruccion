seq 1 2 | xargs -P 2 -I {} sh -c '
  echo "REQUEST {}"
  curl -s -w "\nHTTP: %{http_code}\n" \
    -X POST https://probable-space-memory-9p4v44j7gj4h77v6-8080.app.github.dev/pedido/nuevo \
    -H "Content-Type: application/json" \
    -d "$1"
  echo "----------------"
' _ "$JSON"