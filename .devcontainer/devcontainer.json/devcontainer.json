{
  "name": "Java 25 + Gradle + Spring Boot",

  "image": "mcr.microsoft.com/devcontainers/java:1-25-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "25",
      "installGradle": true,
      "installMaven": false
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot"
      ]
    }
  },

  "forwardPorts": [
    8080
  ]
}